<configuration>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <charset>UTF-8</charset>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} %-5level [%thread] %logger{48} - %msg%n</pattern>
        </encoder>
    </appender>
    <!-- Запись в консоль выполняет worker; заполненная очередь не блокирует Event Loop. -->
    <appender name="ASYNC" class="ch.qos.logback.classic.AsyncAppender">
        <queueSize>4096</queueSize>
        <discardingThreshold>0</discardingThreshold>
        <neverBlock>true</neverBlock>
        <includeCallerData>false</includeCallerData>
        <maxFlushTime>2000</maxFlushTime>
        <appender-ref ref="CONSOLE"/>
    </appender>
    <!-- DEBUG библиотек может включать SQL и сетевые данные. LOG_LEVEL управляет кодом TaskFlow. -->
    <logger name="dev.taskflow" level="${LOG_LEVEL:-INFO}"/>
    <root level="WARN">
        <appender-ref ref="ASYNC"/>
    </root>
</configuration>
